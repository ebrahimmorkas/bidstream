# Copy to .env and adjust. Every value has a sensible default for local development.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite. Example: postgres://bidstream:bidstream@localhost:5432/bidstream
DATABASE_URL=

# Optional. When set, Redis backs the cache, the Channels layer (WebSocket fan-out across
# processes) and the Celery broker. When empty, BidStream uses in-memory equivalents and runs
# Celery tasks synchronously, which is perfect for a single-process dev server.
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BidStream <no-reply@bidstream.local>

# Auction rules
BIDSTREAM_ANTI_SNIPE_MINUTES=2
